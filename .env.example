# Copy this file to ".env" and fill the blanks locally.
# NEVER commit the real .env — it is git-ignored.

# --- Database ---
# Offline default (works with no services running):
DATABASE_URL=sqlite:///data/avip.db
# Production (docker-compose Postgres + TimescaleDB):
# DATABASE_URL=postgresql+psycopg2://avip:CHANGE_ME@localhost:5432/avip
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=avip
POSTGRES_USER=avip
POSTGRES_PASSWORD=

# --- Object storage (evidence clips) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Anthropic (report-writing agent, M8) ---
ANTHROPIC_API_KEY=

# --- Data folders (shared drive) ---
INPUT_DIR=G:/Shared drives/4. AP/lonestar-video-intelligence/incoming
OUTPUT_DIR=G:/Shared drives/4. AP/lonestar-video-intelligence/reports
# Dedicated AI root (Upgrade item 3) — one folder, separate from other company files.
AI_SHARED_ROOT=data/ai_shared

# --- Email agent (Upgrade item 5) — reports/alerts via a GENERIC company AI account.
# ALL of these live here in .env ONLY (never in code or settings.yaml). SMTP_FROM is
# the single from-address; set it later without any code change. Recipients come from
# the fixed list in config/settings.yaml (reports.recipients), NOT from here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# NOTE: DVR passwords are NOT needed here. The PoC reads MP4 files that the
# camera team exports via FreeCam. Do not store DVR credentials in this project.
